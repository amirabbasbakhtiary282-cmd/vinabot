#:kivy 2.3.1
#:import theme src.theme.theme
#:import dp kivy.metrics.dp


<OnboardingScreen>:
    canvas.before:
        Color:
            rgba: theme.bg_primary
        Rectangle:
            pos: self.pos
            size: self.size

    ParticleSystem:
        size_hint: None, None
        size: root.size
        pos: root.pos

    FloatLayout:
        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.86, 0.7
            pos_hint: {'center_x': 0.5, 'center_y': 0.55}
            spacing: dp(18)

            Widget:
                size_hint_y: 0.15

            AiOrb:
                id: onboard_orb
                size_hint: None, None
                size: dp(150), dp(150)
                pos_hint: {'center_x': 0.5}
                is_thinking: True

            Widget:
                size_hint_y: 0.05

            Label:
                text: 'VINΛ'
                font_name: theme.font_name
                font_size: '34sp'
                bold: True
                color: theme.text_primary
                size_hint_y: 0.12

            Label:
                id: onboard_subtitle
                text: root.subtitle_text
                font_name: theme.font_name
                font_size: '15sp'
                color: theme.text_secondary
                halign: 'center'
                valign: 'top'
                text_size: self.width, None
                size_hint_y: 0.35

            Widget:

        BoxLayout:
            orientation: 'vertical'
            size_hint: 0.86, 0.16
            pos_hint: {'center_x': 0.5, 'y': 0.05}
            spacing: dp(12)

            BoxLayout:
                size_hint_y: None
                height: dp(8)
                spacing: dp(6)
                Widget:
                Widget:
                    id: dot0
                    size_hint: None, None
                    size: (dp(20), dp(8)) if root.page_index == 0 else (dp(8), dp(8))
                    canvas:
                        Color:
                            rgba: theme.accent if root.page_index == 0 else theme.glass_border
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(4)]
                Widget:
                    id: dot1
                    size_hint: None, None
                    size: (dp(20), dp(8)) if root.page_index == 1 else (dp(8), dp(8))
                    canvas:
                        Color:
                            rgba: theme.accent if root.page_index == 1 else theme.glass_border
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(4)]
                Widget:
                    id: dot2
                    size_hint: None, None
                    size: (dp(20), dp(8)) if root.page_index == 2 else (dp(8), dp(8))
                    canvas:
                        Color:
                            rgba: theme.accent if root.page_index == 2 else theme.glass_border
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [dp(4)]
                Widget:

            PrimaryButton:
                text: root.button_text
                font_size: '16sp'
                height: dp(52)
                on_release: root.next_page()


<LoginScreen>:
    canvas.before:
        Color:
            rgba: theme.bg_primary
        Rectangle:
            pos: self.pos
            size: self.size

    ParticleSystem:
        size_hint: None, None
        size: root.size
        pos: root.pos

    BoxLayout:
        orientation: 'vertical'
        padding: [dp(28), dp(50), dp(28), dp(30)]
        spacing: dp(14)

        Widget:
            size_hint_y: 0.06

        AiOrb:
            id: login_orb
            size_hint: None, None
            size: dp(96), dp(96)
            pos_hint: {'center_x': 0.5}

        Label:
            text: 'VINΛ'
            font_name: theme.font_name
            font_size: '30sp'
            bold: True
            color: theme.text_primary
            size_hint_y: None
            height: dp(44)

        Label:
            text: root.tagline
            font_name: theme.font_name
            font_size: '13.5sp'
            color: theme.text_secondary
            size_hint_y: None
            height: dp(24)

        Widget:
            size_hint_y: 0.04

        GlassCard:
            orientation: 'vertical'
            size_hint_y: None
            height: dp(230)
            padding: [dp(18), dp(20), dp(18), dp(18)]
            spacing: dp(14)
            radius: theme.radius_lg

            ModernTextField:
                id: username_input
                hint_text: root.username_hint
                size_hint_y: None
                height: dp(48)
                font_size: dp(15)

            ModernTextField:
                id: password_input
                hint_text: root.password_hint
                password: True
                size_hint_y: None
                height: dp(48)
                font_size: dp(15)

            PrimaryButton:
                text: root.login_button_text
                font_size: '16sp'
                height: dp(50)
                on_release: root.do_login()

            Label:
                id: login_status
                text: root.status_text
                font_name: theme.font_name
                color: theme.error
                font_size: '12sp'
                size_hint_y: None
                height: dp(20)

        Widget:
